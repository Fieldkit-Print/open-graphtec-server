# Copy this file to .env and edit values for your setup.
# Example: cp .env.example .env

# API
HOST_API_PORT=8080
LOG_LEVEL=INFO

# Optional API key. When set, all endpoints except /health require the
# X-API-Key request header. Leave empty for trusted-network mode.
API_KEY=

# Maximum accepted PDF / command-sequence size in bytes.
MAX_UPLOAD_BYTES=20971520

# Graphtec cutter connection
CUTTER_HOST=127.0.0.1
CUTTER_PORT=9100

# Steps per mm of the cutter's GP-GL STEP SIZE setting.
# 10 = 0.1 mm (factory default). Must match the cutter or geometry scales.
GPGL_STEPS_PER_MM=10

# DLS worker
# Set true when you have a real cutter available.
DLS_ENABLED=false
DLS_POLL_INTERVAL_SECONDS=1.0
DLS_TIMEOUT_SECONDS=5.0
SEND_RETRY_TOTAL_MS=3000
SEND_RETRY_INTERVAL_MS=50

# Hot-folder ingest worker
INGEST_ENABLED=true
INGEST_POLL_INTERVAL_SECONDS=2.0
INGEST_FILE_MIN_AGE_SECONDS=2.0

# App storage path inside container
APP_DATA_DIR=/data

# Host mount path for the hot folder. Used ONLY by docker-compose.local.yml;
# the default docker-compose.yml stores /data on an internal named volume.
# LOCAL_DATA_DIR=./data

# Multiple cutters (overrides CUTTER_HOST/CUTTER_PORT)
# CUTTERS=left=192.168.1.104:9100,right=192.168.1.105:9100
